{
  "resource_changes": [
    {
      "address": "databricks_job.refresh_silver",
      "type": "databricks_job",
      "mode": "managed",
      "name": "refresh_silver",
      "provider_name": "registry.terraform.io/databricks/databricks",
      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "name": "refresh_silver",
          "description": "Refresh silver table from raw data",
          "max_concurrent_runs": 1,
          "tasks": [
            {
              "task_key": "refresh_task",
              "notebook_task": {
                "notebook_path": "/Workspace/Users/user@example.test/projects/example/notebooks/silver"
              }
            }
          ],
          "job_clusters": [
            {
              "job_cluster_key": "default",
              "new_cluster": {
                "spark_version": "13.3.x-scala2.12",
                "node_type_id": "i3.xlarge",
                "num_workers": 2
              }
            }
          ]
        },
        "after_unknown": {},
        "before_sensitive": false,
        "after_sensitive": {}
      }
    }
  ],
  "configuration": {
    "provider": {
      "databricks": [
        {
          "host": {
            "constant_value": "https://example.cloud.databricks.test"
          }
        }
      ]
    }
  }
}
