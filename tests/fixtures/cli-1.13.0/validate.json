{
  "bundle": {
    "description": "Example analytics bundle with DLT pipeline and refresh job",
    "name": "example-analytics",
    "version": "0.1.0"
  },
  "resources": {
    "jobs": {
      "refresh_silver": {
        "description": "Refresh silver table from raw data",
        "job_clusters": [
          {
            "job_cluster_key": "default",
            "new_cluster": {
              "node_type_id": "i3.xlarge",
              "num_workers": 2,
              "spark_version": "13.3.x-scala2.12"
            }
          }
        ],
        "max_concurrent_runs": 1,
        "name": "refresh_silver",
        "tasks": [
          {
            "job_cluster_key": "default",
            "notebook_task": {
              "notebook_path": "/Workspace/Users/user@example.test/projects/example/notebooks/silver"
            },
            "task_key": "refresh_task"
          }
        ]
      }
    },
    "pipelines": {
      "dlt_pipeline": {
        "channel": "CURRENT",
        "clusters": [
          {
            "label": "default",
            "spark_conf": {
              "spark.databricks.cluster.profile": "singleNode"
            }
          }
        ],
        "configuration": {
          "query_table": {
            "tables": [
              {
                "name": "query_result"
              }
            ]
          }
        },
        "name": "dlt_pipeline",
        "pipeline_type": "TRIGGERED",
        "storage": "/Workspace/Users/user@example.test/projects/example/storage"
      }
    }
  },
  "workspace": {
    "root_path": "/Workspace/Users/user@example.test/projects/example-dev"
  }
}
